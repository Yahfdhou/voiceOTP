# Copier vers .env et remplir. Ne jamais committer .env.

FLASK_DEBUG=0
ENV=production
FLASK_SECRET_KEY=
# Obligatoire : >= 24 caractères aléatoires (ex. openssl rand -hex 32)
OTP_SECRET=
ADMIN_API_KEY=
REDIS_URL=redis://localhost:6379/0
PRODUCT_BASE=https://voiceotp.duckdns.org
# ORIGINES dashboard uniquement — * est refusé si ENV=production
CORS_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3001
# 1 = faire confiance à X-Forwarded-For / X-Real-IP (Nginx)
TRUST_PROXY=1
# 1 = /auth/* sans clé — INTERDIT si ENV=production
ENABLE_LEGACY_AUTH=0
# 1 = clés démo — INTERDIT si ENV=production
ENABLE_DEMO_KEYS=0
VOICE_LOCAL_EXT=1000
# lab | trunk | telnyx  (telnyx = Say/TTS cloud, pas de RTP local)
VOICE_PROVIDER=lab
SIP_TRUNK_NAME=trunk
SIP_TRUNK_STRIP_PLUS=1
SIP_TRUNK_CALLER_ID=VoiceOTP
TELNYX_FROM=+1XXXXXXXXXX
TELNYX_API_KEY=
TELNYX_TEXML_APP_ID=
TELNYX_CONNECTION_ID=
TELNYX_ACCOUNT_SID=
PBX_ARI_URL=http://localhost:8088/ari/channels
PBX_USER=voiceotp-user
PBX_PASS=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

CHINQIT_API_KEY=
CHINQIT_API_URL=https://sms.chinqit.com/api/v2/notify
CHINQIT_CODE_URL=https://sms.chinqit.com/api/v2/code
CHINQIT_CHECK_URL=https://sms.chinqit.com/api/v2/check
